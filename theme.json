{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Midnight", "color": "#060a14" },
				{ "slug": "surface", "name": "Night", "color": "#0b1222" },
				{ "slug": "surface-raised", "name": "Dusk", "color": "#10182b" },
				{ "slug": "contrast", "name": "Frost", "color": "#f1f5ff" },
				{ "slug": "text", "name": "Silver text", "color": "#c3cee8" },
				{ "slug": "silver", "name": "Silver", "color": "#dfe8ff" },
				{ "slug": "muted", "name": "Muted", "color": "#8f9cba" },
				{ "slug": "border", "name": "Line", "color": "#27324d" },
				{ "slug": "teal", "name": "Aurora teal", "color": "#3ee6c1" },
				{ "slug": "violet", "name": "Aurora violet", "color": "#8a6cff" },
				{ "slug": "rose", "name": "Aurora rose", "color": "#ff6fae" },
				{ "slug": "on-accent", "name": "Text on accent", "color": "#04110e" },
				{ "slug": "ancient", "name": "Item: ancient", "color": "#ffd27a" },
				{ "slug": "option", "name": "Item: option", "color": "#8fb0ff" }
			],
			"gradients": [
				{ "slug": "aurora", "name": "Aurora", "gradient": "linear-gradient(110deg, #3ee6c1 0%, #8a6cff 55%, #ff6fae 100%)" },
				{ "slug": "aurora-soft", "name": "Aurora soft", "gradient": "linear-gradient(110deg, rgb(62 230 193 / 22%) 0%, rgb(138 108 255 / 22%) 55%, rgb(255 111 174 / 18%) 100%)" },
				{ "slug": "night", "name": "Night", "gradient": "linear-gradient(180deg, #10182b 0%, #060a14 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Marcellus SC",
					"fontFamily": "\"Marcellus SC\", \"Palatino Linotype\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Marcellus SC", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/marcellus-sc.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-var.woff2" ] }
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3.25rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "4rem", "fluid": { "min": "2.5rem", "max": "5.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "0.875rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 2rem + 4vw, 5.5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 2.5rem + 6vw, 8rem)" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": {
			"presets": [
				{ "slug": "glass", "name": "Glass", "shadow": "0 18px 50px -20px rgb(0 0 0 / 70%)" },
				{ "slug": "glow", "name": "Aurora glow", "shadow": "0 0 40px -8px rgb(62 230 193 / 45%)" }
			]
		},
		"custom": {
			"radius": { "s": "8px", "m": "14px", "l": "22px" },
			"line": "rgb(223 232 255 / 14%)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--text)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": { "left": "clamp(1rem, 4vw, 2.5rem)", "right": "clamp(1rem, 4vw, 2.5rem)" },
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--teal)" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } },
				":focus": { "color": { "text": "var(--wp--preset--color--contrast)" } },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "0.01em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.12" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--base)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "textTransform": "uppercase", "letterSpacing": "0.12em" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--teal)", "text": "var(--wp--preset--color--on-accent)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "700", "letterSpacing": "0.04em", "textDecoration": "none" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8em", "bottom": "0.8em", "left": "1.7em", "right": "1.7em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--on-accent)" } }
			}
		},
		"blocks": {
			"core/paragraph": { "typography": { "lineHeight": "1.75" } },
			"core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400", "textDecoration": "none" } },
			"core/code": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.9em" } },
			"core/separator": { "color": { "text": "var(--wp--custom--line)" } }
		}
	},
	"customTemplates": [],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
